# ChronoSeek Subnet Configuration
# Copy this file to .env and update the values.

# Chain
# Bittensor network to connect to: finney, test, or local.
NETWORK=finney
# Subnet netuid on the selected network.
NETUID=1

# Wallet
# Coldkey wallet name used by miner/validator commands.
WALLET_NAME=default
# Hotkey name registered on the subnet.
HOTKEY_NAME=default
# Path to local Bittensor wallet storage.
WALLET_PATH=~/.bittensor/wallets

# Chutes
# Chutes API token used for runtime build/deploy and private runtime requests.
CHUTES_API_KEY=
# Base domain used to resolve miner chute_slug submissions.
CHUTES_BASE_DOMAIN=chutes.ai
# Minimum validator stake accepted by the Chutes runtime /search endpoint.
MIN_VALIDATOR_STAKE=10000

# Video Download
# Optional absolute path to a Netscape cookies.txt file for validator/miner yt-dlp authenticated downloads.
# When building a Chutes image, this file is copied into the image and the runtime env is rewritten to the container path.
YTDLP_COOKIES=
# Browser cookie source used by yt-dlp when no cookies.txt file is available.
# Leave unset/empty on servers and CI. If you want yt-dlp to import cookies from
# a local browser profile, set something like "chrome:Default" (see yt-dlp docs).
YTDLP_COOKIES_BROWSER=
# Optional Node.js runtime path for yt-dlp EJS challenge solving. Prefer Deno in Chutes images unless you install Node yourself.
YTDLP_NODE_PATH=
# Deno runtime path for yt-dlp EJS challenge solving. The example Chutes image installs Deno here.
YTDLP_DENO_PATH=/opt/deno/bin/deno

# Hugging Face
# Hugging Face token used for ActivityNet and model downloads.
HF_TOKEN=hf_your_token_here
# Hugging Face cache directory.
HF_HOME=~/.cache/huggingface
# Optional ActivityNet JSON filename override inside the downloaded snapshot.
HF_ACTIVITYNET_FILENAME=

# Validator Task Generation
# Optional local ActivityNet-style manifest path. If unset, the validator loads ActivityNet from Hugging Face.
TASK_DATASET_PATH=
# Dataset split used for validator task sampling.
TASK_SPLIT=validation
# Require validator tasks to use videos that pass an accessibility check before querying miners.
REQUIRE_ACCESSIBLE_VIDEOS=1
# Max attempts to sample an accessible validator task before falling back to cached accessible videos.
TASK_MAX_SAMPLING_ATTEMPTS=50
# Enable private ActivityNet-derived task clips uploaded to Hippius. Keep disabled for local bootstrap tests.
ENABLE_HARDENED_TASKS=0
# Secret seed used by validators to sample private tasks deterministically. Set a long random value in production.
VALIDATOR_TASK_SECRET=
# Maximum hardened task generation attempts before the validator skips the current step.
HARDENED_TASK_MAX_GENERATION_ATTEMPTS=5
# Private query variant manifest path. Do not commit this file.
TASK_QUERY_VARIANTS_PATH=
# Local cache directory for clipped/compressed validator task artifacts.
TASK_CLIP_CACHE_DIR=~/.cache/chronoseek/task-clips
# Optional local JSON manifest path for uploaded validator task artifacts.
TASK_ARTIFACT_MANIFEST_PATH=
# Object-key prefix for task clips uploaded to Hippius.
TASK_ARTIFACT_PREFIX=task-clips
# Hours before validator task clips expire from the local manifest/cache.
TASK_CLIP_TTL_HOURS=6
# Minimum seconds between cleanup passes for expired task artifacts.
TASK_CLIP_CLEANUP_INTERVAL_SECONDS=900
# Delete expired uploaded task clips from Hippius during cleanup. Keep disabled to preserve videos for later use.
TASK_DELETE_REMOTE_ARTIFACTS=0
# Cooldown before reusing the same source video for validation.
TASK_VIDEO_COOLDOWN_HOURS=24
# Cooldown before reusing the same source caption for validation.
TASK_CAPTION_COOLDOWN_HOURS=168
# Minimum generated validation clip duration in seconds.
TASK_MIN_CLIP_DURATION_SECONDS=30
# Maximum generated validation clip duration in seconds.
TASK_MAX_CLIP_DURATION_SECONDS=180
# Timeout in seconds for downloading ActivityNet source videos during clipping.
TASK_SOURCE_DOWNLOAD_TIMEOUT_SECONDS=120
# Encoding profile name recorded in the task artifact manifest.
TASK_ENCODING_PROFILE_NAME=h264-720p-v1
# Maximum generated task clip width.
TASK_CLIP_MAX_WIDTH=1280
# Maximum generated task clip height.
TASK_CLIP_MAX_HEIGHT=720
# Generated task clip video bitrate.
TASK_CLIP_VIDEO_BITRATE=1500k
# Generated task clip audio bitrate.
TASK_CLIP_AUDIO_BITRATE=96k
# Enable randomized hardened task context/encoding transforms.
ENABLE_ADVERSARIAL_TASK_TRANSFORMS=1
# Enable randomized encoding profile variants for hardened task clips.
ENABLE_TASK_ENCODING_PROFILE_VARIANTS=1
# Fraction of hardened tasks converted into internal canary tasks. Disabled by default.
CANARY_TASK_RATE=0
# Optional pipe-separated absent-query prompts for canary tasks.
ABSENT_CANARY_QUERIES=

# Validator Task Storage
# Hippius S3-compatible endpoint for validator task uploads.
HIPPIUS_S3_ENDPOINT_URL=https://s3.hippius.com
# Public base URL used by miners to fetch uploaded validator task clips.
# The canonical public URL is https://s3.hippius.com/chronoseek/task-clips/<video-file-name-or-id>.
HIPPIUS_S3_PUBLIC_BASE_URL=https://s3.hippius.com
# Hippius bucket used for validator task clips.
HIPPIUS_S3_BUCKET=chronoseek
# Hippius S3 access key ID. Keep this secret in validator runtime env only.
HIPPIUS_S3_ACCESS_KEY_ID=
# Hippius S3 secret access key. Keep this secret in validator runtime env only.
HIPPIUS_S3_SECRET_ACCESS_KEY=
# S3 signing region for Hippius.
HIPPIUS_S3_REGION=decentralized
# Timeout in seconds for Hippius upload/download/delete operations.
HIPPIUS_S3_TIMEOUT_SECONDS=60

# Optional Vidaio Compression
# Try Vidaio compression before falling back to local ffmpeg.
VIDAIO_COMPRESSION_ENABLED=0
# Vidaio compression API base URL. Optional until the API contract is stable.
VIDAIO_API_BASE_URL=
# Vidaio API token. Keep this secret in validator runtime env only.
VIDAIO_API_KEY=
# Timeout in seconds for Vidaio compression.
VIDAIO_TIMEOUT_SECONDS=60

# Validator Video Availability Cache
# Optional legacy base cache path used to derive accessible/inaccessible cache paths when specific paths are unset.
VIDEO_AVAILABILITY_CACHE_PATH=
# Optional JSON cache path for videos confirmed accessible by the validator.
ACCESSIBLE_VIDEO_CACHE_PATH=
# Optional JSON cache path for videos confirmed inaccessible by the validator.
INACCESSIBLE_VIDEO_CACHE_PATH=
# TTL for validator video availability cache entries.
VIDEO_AVAILABILITY_CACHE_TTL_HOURS=24
# Timeout in seconds for validator-side video accessibility checks.
VIDEO_AVAILABILITY_TIMEOUT=20

# Validator Evaluation
# Per-miner timeout in seconds for validator runtime /search requests.
MINER_REQUEST_TIMEOUT_SECONDS=150
# Number of miner results requested and scored for synthetic validation.
VALIDATOR_EVAL_TOP_K=1
# Maximum scored miner interval duration unless a ground-truth interval is longer.
TASK_MAX_PREDICTION_DURATION_SECONDS=60
# Cache TTL in seconds for loaded miner metadata submissions.
MINER_SUBMISSION_CACHE_TTL_SECONDS=300
# Interval in seconds between validator submission metadata refreshes.
MINER_SUBMISSION_REFRESH_INTERVAL_SECONDS=60
# Per-runtime timeout in seconds for responsive miner /health checks.
MINER_SUBMISSION_HEALTH_TIMEOUT_SECONDS=10
# Optional JSON path for validator miner behavior telemetry snapshots.
VALIDATOR_TELEMETRY_PATH=
# Percent of miner emissions to burn by assigning weight to UID 0.
MINER_EMISSION_BURN_PERCENT=0

# Logging
# Logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
