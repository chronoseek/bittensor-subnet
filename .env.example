# ChronoSeek operator configuration
# Copy this file to .env and fill in the values for your role.
#
# Runtime tuning defaults live as constants in chronoseek/constants.py and can be
# overridden with CLI flags. Keep .env focused on identity, credentials,
# secrets, and host-specific access files.

# Chain
NETWORK=finney
NETUID=20

# Validator Docker deployment
# Must match the image published by .github/workflows/docker-publish.yml.
DOCKER_IMAGE=creativeessence/chronoseek-subnet:latest

# Wallet
WALLET_NAME=default
HOTKEY_NAME=default
WALLET_PATH=~/.bittensor/wallets

# Chutes
# Required for validators querying private miner runtimes and for production
# Chutes build/deploy helpers.
CHUTES_API_KEY=
# Base domain used to resolve miner chute_slug submissions.
CHUTES_BASE_DOMAIN=chutes.ai

# Minimum validator stake accepted by the Chutes runtime /search endpoint.
MIN_VALIDATOR_STAKE=10000


# Hugging Face
# Required for Hugging Face ActivityNet/model downloads unless a validator
# passes --task-dataset-path.
HF_TOKEN=

# Hardened validator tasks
# Hardened task generation is enabled by default. The secret and Hippius
# credentials are required for normal validator operation.
# Endpoint, region, TTL, clip settings, and hardened-mode switches use
# code defaults unless overridden with validator.py CLI flags or constants.
VALIDATOR_TASK_SECRET=
# Bucket name must be one your Hippius credentials own or can create; the
# shared "chronoseek" default may already be owned by another operator.
HIPPIUS_S3_BUCKET=chronoseek
HIPPIUS_S3_ACCESS_KEY_ID=
HIPPIUS_S3_SECRET_ACCESS_KEY=

# Optional shared validator/miner video access
# YTDLP_COOKIES should point to a Netscape cookies.txt file. Miner Chutes image
# builds copy a readable cookies file into the runtime image. Set Node/Deno
# paths only when yt-dlp needs an explicit JS runtime on this host.
YTDLP_COOKIES=
YTDLP_COOKIES_BROWSER=
YTDLP_DENO_PATH=
YTDLP_NODE_PATH=

# Cookie refresh client settings used by both axon runtimes and Chutes. Put
# these in the axon miner's .env; configure them as Chutes Secrets for each
# remote deployment rather than baking them into an image.
COOKIE_REFRESH_URL=
COOKIE_REFRESH_BINDING_ID=
COOKIE_REFRESH_SHARED_SECRET=
COOKIE_REFRESH_TIMEOUT_SECONDS=15
COOKIE_REFRESH_INTERVAL_SECONDS=3600
# Optional client-side destination used only when YTDLP_COOKIES is empty.
# Chutes defaults to /tmp/chronoseek-cookie-cache/cookies.txt.
COOKIE_REFRESH_CACHE_PATH=

# Miner-side refresh service (run separately from the one-shot miner.py commit).
COOKIE_REFRESH_REGISTRY_PATH=
COOKIE_REFRESH_HOST=127.0.0.1
COOKIE_REFRESH_PORT=8091
COOKIE_REFRESH_MAX_CLOCK_SKEW_SECONDS=30

# Vidaio compression
# Enabled by default. If Vidaio fails, validators fall back to local ffmpeg.
VIDAIO_COMPRESSION_ENABLED=1
VIDAIO_API_KEY=
VIDAIO_POLL_INTERVAL_SECONDS=15

# Miner runtime auth
# Used by miner Chutes runtimes that enforce validator hotkey stake checks.
MIN_VALIDATOR_STAKE=10000


# Validator Task Generation
# Optional local ActivityNet-style manifest path. If unset, the validator uses the configured HF source/bootstrap path.
TASK_DATASET_PATH=
# Dataset split used for validator task sampling.
TASK_SPLIT=validation
# Require validator tasks to use videos that pass an accessibility check before querying miners.
REQUIRE_ACCESSIBLE_VIDEOS=1
# Max attempts to sample an accessible validator task before falling back to cached accessible videos.
TASK_MAX_SAMPLING_ATTEMPTS=50


# Validator Video Availability Cache
# Optional legacy base cache path used to derive accessible/inaccessible cache paths when specific paths are unset.
VIDEO_AVAILABILITY_CACHE_PATH=
# Optional JSON cache path for videos confirmed accessible by the validator.
ACCESSIBLE_VIDEO_CACHE_PATH=
# Optional JSON cache path for videos confirmed inaccessible by the validator.
INACCESSIBLE_VIDEO_CACHE_PATH=
# TTL for validator video availability cache entries.
VIDEO_AVAILABILITY_CACHE_TTL_HOURS=24
# Timeout in seconds for validator-side video accessibility checks.
VIDEO_AVAILABILITY_TIMEOUT=20

# Validator Evaluation
# Per-miner timeout in seconds for validator runtime /search requests.
MINER_REQUEST_TIMEOUT_SECONDS=150
# Cache TTL in seconds for loaded miner metadata submissions.
MINER_SUBMISSION_CACHE_TTL_SECONDS=300
# Interval in seconds between validator submission metadata refreshes.
MINER_SUBMISSION_REFRESH_INTERVAL_SECONDS=60
# Per-runtime timeout in seconds for responsive miner /health checks.
MINER_SUBMISSION_HEALTH_TIMEOUT_SECONDS=10
# Percent of miner emissions to burn by assigning weight to UID 0.
MINER_EMISSION_BURN_PERCENT=0


# Logging
LOG_LEVEL=INFO
